# ==============================================================================
# ⚡ ARENA QUIZ PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env (or server/.env) to override default settings.
# All settings have safe built-in defaults for instant local & campus running.
# ==============================================================================

# Server Network Port
PORT=3001

# Allowed Origins for CORS (Comma-separated)
# For local dev, Vite runs on 5173. Add your domain or public IP if deploying.
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# JWT Secret for Host Authentication Tokens
# In production, replace with a strong random 64-character secret.
JWT_SECRET=arena_change_this_to_a_secure_random_key_in_production_2026

# Demo Mode (true/false)
# When true, the default host login admin@arena.edu / admin123 is active.
DEMO_MODE=true

# Large-Audience Concurrency Limits
# For high-traffic events (auditoriums / fests), tune these up:
MAX_PLAYERS_PER_ROOM=500
MAX_ROOMS=200
